// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
// PostgreSQL (Neon in production). Set DATABASE_URL in Render's environment
// and in your local .env file. See README "Database".
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// Pricing settings for each shop (stored as JSON so new options don't need a migration).
model ShopSettings {
  shop      String   @id
  data      String
  updatedAt DateTime @updatedAt
}

// One row per "Apply prices" run. `changes` keeps old and new prices so a run can be undone.
model PriceRun {
  id           Int      @id @default(autoincrement())
  shop         String
  createdAt    DateTime @default(now())
  kind         String   @default("apply")
  gram24       Float?
  usdPerOunce  Float?
  usdEgp       Float?
  updatedCount Int      @default(0)
  failedCount  Int      @default(0)
  changes      String
  errors       String?
  undone       Boolean  @default(false)

  @@index([shop, createdAt])
}

// The price plan shown in a preview. "Apply" reads the prices from here (not from the
// browser), and appliedAt makes sure one preview can only be applied once.
model PricePreview {
  id          String    @id @default(cuid())
  shop        String
  createdAt   DateTime  @default(now())
  gram24      Float?
  usdPerOunce Float?
  usdEgp      Float?
  rows        String
  appliedAt   DateTime?

  @@index([shop, createdAt])
}

// Daily market price history, shared by all stores (market data, not store data).
// One row per metal per day (Cairo date), holding the last price seen that day.
// Daily metal price history per store currency. The usdEgp and egpPerGram columns
// keep their original names but hold the USD -> `currency` rate and the price per
// gram in `currency` (EGP for rows from before multi-currency).
model MetalRate {
  id          Int      @id @default(autoincrement())
  metal       String
  day         String
  currency    String   @default("EGP")
  usdPerOunce Float
  usdEgp      Float
  egpPerGram  Float
  source      String
  updatedAt   DateTime @updatedAt

  @@unique([metal, day, currency])
  @@index([day])
}

// One row per scheduled automatic update (store + scheduled time). The unique key makes
// sure each scheduled time runs once, even if the timer calls twice.
// status: running | applied | held | stopped | skipped | failed.
model AutoRun {
  id           Int      @id @default(autoincrement())
  shop         String
  slot         DateTime
  createdAt    DateTime @default(now())
  status       String   @default("running")
  message      String?
  updatedCount Int      @default(0)
  heldCount    Int      @default(0)
  runId        Int?
  attempts     Int      @default(1)
  lastTryAt    DateTime @default(now())

  @@unique([shop, slot])
  @@index([shop, createdAt])
}

// Small app-wide values, e.g. when the outside timer last called /api/auto-run.
model AppState {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// One row per variant price the app changed (apply, automatic, undo, restore), so
// each variant has its own price history. runId points to the PriceRun.
model PriceChange {
  id           Int      @id @default(autoincrement())
  shop         String
  runId        Int?
  kind         String
  createdAt    DateTime @default(now())
  productId    String
  variantId    String
  productTitle String
  variantTitle String   @default("")
  oldPrice     Float
  newPrice     Float

  @@index([shop, variantId, createdAt])
  @@index([shop, createdAt])
}

// Activity log: who did what, and when. actor: "Automatic" or the staff member.
model AuditLog {
  id        Int      @id @default(autoincrement())
  shop      String
  createdAt DateTime @default(now())
  actor     String
  action    String
  summary   String

  @@index([shop, createdAt])
}
